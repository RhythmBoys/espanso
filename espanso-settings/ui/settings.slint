import { Button, LineEdit, TextEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct MatchRow {
    id: string,
    trigger: string,
    preview: string,
}

export component SettingsWindow inherits Window {
    title: "Espanso Settings";
    preferred-width: 1040px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: #f5f7fb;

    in property <string> config-path;
    in property <string> source-label;
    in property <bool> can-change-location: true;
    in-out property <int> active-tab: 0;
    in-out property <string> selected-path;
    in-out property <string> migration-summary;
    in-out property <bool> migration-ready: false;
    in-out property <string> status-message: "就绪";
    in-out property <string> error-message;
    in-out property <bool> confirm-discard-visible: false;
    in-out property <bool> undo-visible: false;
    in-out property <string> selected-id;
    in-out property <string> filter-text;
    in-out property <string> trigger-text;
    in-out property <string> replacement-text;
    in property <[MatchRow]> match-rows;

    callback request-tab-switch(int);
    callback confirm-discard();
    callback cancel-discard();
    callback draft-changed();
    callback choose-folder();
    callback migrate();
    callback open-config();
    callback new-match();
    callback select-match(string);
    callback save-match();
    callback delete-match(string);
    callback undo-delete();
    callback commit-deletion();
    callback apply-filter(string);

    VerticalBox {
        padding: 18px;
        spacing: 12px;

        Text {
            text: "Espanso Settings";
            font-size: 26px;
            font-weight: 700;
            color: #172033;
        }
        Text {
            text: "当前配置：" + root.config-path + "  ·  " + root.source-label;
            color: #526078;
            overflow: elide;
        }

        if root.error-message != "": Rectangle {
            background: #feeceb;
            border-color: #e5484d;
            border-width: 1px;
            border-radius: 6px;
            min-height: 44px;
            Text {
                text: root.error-message;
                color: #a8242a;
                wrap: word-wrap;
                vertical-alignment: center;
                x: 12px;
                width: parent.width - 24px;
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "设置";
                primary: root.active-tab == 0;
                clicked => { root.request-tab-switch(0); }
            }
            Button {
                text: "配置";
                primary: root.active-tab == 1;
                clicked => { root.request-tab-switch(1); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.status-message; color: #526078; vertical-alignment: center; }
        }

        if root.confirm-discard-visible: Rectangle {
            background: #fff8df;
            border-color: #d6a100;
            border-width: 1px;
            border-radius: 6px;
            min-height: 58px;
            HorizontalBox {
                padding: 8px;
                Text {
                    text: "有未保存更改，确定放弃并切换页面吗？";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button { text: "继续编辑"; clicked => { root.cancel-discard(); } }
                Button { text: "放弃更改"; clicked => { root.confirm-discard(); } }
            }
        }

        if root.active-tab == 0: VerticalBox {
            spacing: 12px;
            Rectangle {
                background: white;
                border-radius: 8px;
                border-color: #dce2eb;
                border-width: 1px;
                vertical-stretch: 1;
                VerticalBox {
                    padding: 18px;
                    spacing: 12px;
                    Text { text: "配置目录"; font-size: 20px; font-weight: 600; color: #172033; }
                    Text {
                        text: "选择新目录后会先预检，再复制、验证并切换。旧目录不会被删除。";
                        color: #526078;
                        wrap: word-wrap;
                    }
                    LineEdit { text: root.config-path; read-only: true; }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: "打开当前目录"; clicked => { root.open-config(); } }
                        Button {
                            text: "选择新目录…";
                            enabled: root.can-change-location;
                            clicked => { root.choose-folder(); }
                        }
                    }
                    if !root.can-change-location: Text {
                        text: "当前由命令行或环境变量覆盖路径，不能永久切换。";
                        color: #a15c00;
                    }
                    if root.selected-path != "": VerticalBox {
                        spacing: 8px;
                        Text { text: "目标目录：" + root.selected-path; color: #172033; }
                        Text { text: root.migration-summary; color: #526078; wrap: word-wrap; }
                        Button {
                            text: "复制并切换";
                            enabled: root.migration-ready;
                            clicked => { root.migrate(); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        if root.active-tab == 1: HorizontalBox {
            spacing: 12px;
            Rectangle {
                background: white;
                border-radius: 8px;
                border-color: #dce2eb;
                border-width: 1px;
                horizontal-stretch: 1;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalBox {
                        LineEdit {
                            text <=> root.filter-text;
                            placeholder-text: "搜索触发词或替换内容";
                            horizontal-stretch: 1;
                        }
                        Button { text: "搜索"; clicked => { root.apply-filter(root.filter-text); } }
                    }
                    Button { text: "新增规则"; clicked => { root.new-match(); } }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            spacing: 6px;
                            for row in root.match-rows: Rectangle {
                                min-height: 58px;
                                background: #f8f9fc;
                                border-radius: 5px;
                                HorizontalBox {
                                    padding: 8px;
                                    VerticalBox {
                                        horizontal-stretch: 1;
                                        Text { text: row.trigger; font-weight: 600; color: #172033; }
                                        Text { text: row.preview; color: #69758a; overflow: elide; }
                                    }
                                    Button { text: "编辑"; clicked => { root.select-match(row.id); } }
                                    Button { text: "删除"; clicked => { root.delete-match(row.id); } }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                background: white;
                border-radius: 8px;
                border-color: #dce2eb;
                border-width: 1px;
                horizontal-stretch: 2;
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: root.selected-id == "" ? "新建规则" : "编辑规则"; font-size: 20px; font-weight: 600; }
                    Text { text: "触发文本"; color: #526078; }
                    LineEdit {
                        text <=> root.trigger-text;
                        placeholder-text: ":hello";
                        edited => { root.draft-changed(); }
                    }
                    Text { text: "替换后的长文本"; color: #526078; }
                    TextEdit {
                        text <=> root.replacement-text;
                        vertical-stretch: 1;
                        edited => { root.draft-changed(); }
                    }
                    HorizontalBox {
                        Text { text: "支持多行、emoji 与中日韩字符"; color: #69758a; horizontal-stretch: 1; }
                        if root.undo-visible: Button { text: "撤销删除"; clicked => { root.undo-delete(); } }
                        if root.undo-visible: Button { text: "保存删除"; clicked => { root.commit-deletion(); } }
                        Button { text: "保存规则"; primary: true; clicked => { root.save-match(); } }
                    }
                }
            }
        }
    }
}
